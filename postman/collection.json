    },
    {
      "name": "2 - Waste Pickup API",
      "item": [
        {
          "name": "POST Create pickup",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/pickups",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"household_id\": \"{{household_id}}\", \"type\": \"organic\"}", "options": { "raw": { "language": "json" } } },
            "description": "Buat permintaan pickup baru (type: organic/plastic/paper/electronic). 201 status pending, id tersimpan ke pickup_id. 409 jika household punya payment pending (aturan 1)."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 201', function () { pm.response.to.have.status(201); });", "try { var j = pm.response.json(); if (j.data && j.data.id) { pm.collectionVariables.set('pickup_id', j.data.id); } } catch (e) {}"] } }],
          "response": [
            {
              "name": "201 Created",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/pickups" },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":{\"id\":\"a1111111-1111-1111-1111-111111111111\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"type\":\"organic\",\"status\":\"pending\",\"pickup_date\":null,\"safety_check\":null,\"created_at\":\"2026-10-08T10:00:00Z\",\"updated_at\":\"2026-10-08T10:00:00Z\"}}"
            },
            {
              "name": "409 Conflict (aturan 1)",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/pickups" },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"error\",\"message\":\"household masih memiliki payment pending\"}"
            }
          ]
        },
        {
          "name": "POST Create pickup (electronic)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/pickups",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"household_id\": \"{{household_id}}\", \"type\": \"electronic\", \"safety_check\": true}", "options": { "raw": { "language": "json" } } },
            "description": "Contoh khusus e-waste. Sertakan safety_check true agar bisa di-schedule (aturan 3). id tersimpan ke pickup_id, lalu lanjut ke PUT Schedule pickup (electronic)."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/pickups" },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":{\"id\":\"a2222222-2222-2222-2222-222222222222\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"type\":\"electronic\",\"status\":\"pending\",\"pickup_date\":null,\"safety_check\":true,\"created_at\":\"2026-10-08T10:00:00Z\",\"updated_at\":\"2026-10-08T10:00:00Z\"}}"
            }
          ]
        },
        {
          "name": "GET List pickups",
          "request": { "method": "GET", "url": "{{base_url}}/api/pickups?status=pending&household_id={{household_id}}", "description": "Daftar pickup, dapat difilter status dan household_id (keduanya opsional). 200 + meta pagination." },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "header": [], "url": "{{base_url}}/api/pickups?status=pending&household_id={{household_id}}" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":[{\"id\":\"a1111111-1111-1111-1111-111111111111\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"type\":\"organic\",\"status\":\"pending\",\"pickup_date\":null,\"safety_check\":null,\"created_at\":\"2026-10-08T10:00:00Z\",\"updated_at\":\"2026-10-08T10:00:00Z\"}],\"meta\":{\"total\":1,\"page\":1,\"limit\":10,\"total_pages\":1}}"
            }
          ]
        },
        {
          "name": "PUT Schedule pickup",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/pickups/{{pickup_id}}/schedule",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"pickup_date\": \"2026-10-12T09:00:00Z\"}", "options": { "raw": { "language": "json" } } },
            "description": "Jadwalkan pickup non-electronic: status pending menjadi scheduled. Format pickup_date RFC3339 (contoh 2026-10-12T09:00:00Z, tanggal saja 2026-10-12 juga diterima). 409 jika bukan pending."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/pickups/{{pickup_id}}/schedule" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":{\"id\":\"a1111111-1111-1111-1111-111111111111\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"type\":\"organic\",\"status\":\"scheduled\",\"pickup_date\":\"2026-10-12T09:00:00Z\",\"safety_check\":null,\"created_at\":\"2026-10-08T10:00:00Z\",\"updated_at\":\"2026-10-08T10:05:00Z\"}}"
            }
          ]
        },
        {
          "name": "PUT Schedule pickup (electronic)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/pickups/{{pickup_id}}/schedule",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"pickup_date\": \"2026-10-12T09:00:00Z\", \"safety_check\": true}", "options": { "raw": { "language": "json" } } },
            "description": "Contoh khusus e-waste: wajib sertakan safety_check true, selain itu 422. Buat pickup electronic dulu via POST Create pickup (electronic), lalu schedule via request ini."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/pickups/{{pickup_id}}/schedule" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":{\"id\":\"a2222222-2222-2222-2222-222222222222\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"type\":\"electronic\",\"status\":\"scheduled\",\"pickup_date\":\"2026-10-12T09:00:00Z\",\"safety_check\":true,\"created_at\":\"2026-10-08T10:00:00Z\",\"updated_at\":\"2026-10-08T10:05:00Z\"}}"
            },
            {
              "name": "422 Tanpa safety_check (aturan 3)",
              "originalRequest": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/pickups/{{pickup_id}}/schedule" },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"error\",\"message\":\"pickup electronic mewajibkan safety_check true\"}"
            }
          ]
        },
        {
          "name": "PUT Complete pickup",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/pickups/{{pickup_id}}/complete",
            "description": "Tandai pickup selesai. Otomatis membuat payment pending (organic/plastic/paper 50000, electronic 100000). id payment tersimpan ke payment_id."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "try { var j = pm.response.json(); if (j.data && j.data.payment && j.data.payment.id) { pm.collectionVariables.set('payment_id', j.data.payment.id); } } catch (e) {}"] } }],
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "PUT", "header": [], "url": "{{base_url}}/api/pickups/{{pickup_id}}/complete" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":{\"pickup\":{\"id\":\"a1111111-1111-1111-1111-111111111111\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"type\":\"organic\",\"status\":\"completed\",\"pickup_date\":\"2026-10-12T09:00:00Z\",\"safety_check\":null,\"created_at\":\"2026-10-08T10:00:00Z\",\"updated_at\":\"2026-10-08T11:00:00Z\"},\"payment\":{\"id\":\"b0000000-0000-0000-0000-000000000001\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"waste_id\":\"a1111111-1111-1111-1111-111111111111\",\"amount\":50000,\"payment_date\":null,\"status\":\"pending\",\"proof_file_url\":null,\"created_at\":\"2026-10-08T11:00:00Z\",\"updated_at\":\"2026-10-08T11:00:00Z\"}}}"
            }
          ]
        },
        {
          "name": "PUT Cancel pickup",
          "request": { "method": "PUT", "url": "{{base_url}}/api/pickups/{{pickup_id}}/cancel", "description": "Batalkan pickup (tidak berlaku untuk yang sudah completed/canceled). Untuk mencoba request ini, buat pickup baru dulu via request pertama folder ini." },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "PUT", "header": [], "url": "{{base_url}}/api/pickups/{{pickup_id}}/cancel" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":{\"id\":\"a1111111-1111-1111-1111-111111111111\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"type\":\"organic\",\"status\":\"canceled\",\"pickup_date\":null,\"safety_check\":null,\"created_at\":\"2026-10-08T10:00:00Z\",\"updated_at\":\"2026-10-08T11:00:00Z\"}}"
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Payment API",
      "item": [
        {
          "name": "POST Create payment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/payments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"household_id\": \"{{household_id}}\", \"waste_id\": \"{{pickup_id}}\", \"amount\": 50000}", "options": { "raw": { "language": "json" } } },
            "description": "Buat payment manual. waste_id adalah pickup_id (id dari pickup terkait). Nominal wajib sesuai tarif tipe pickup (electronic 100000, lainnya 50000). 201, id tersimpan ke payment_id."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 201', function () { pm.response.to.have.status(201); });", "try { var j = pm.response.json(); if (j.data && j.data.id) { pm.collectionVariables.set('payment_id', j.data.id); } } catch (e) {}"] } }],
          "response": [
            {
              "name": "201 Created",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/payments" },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":{\"id\":\"b0000000-0000-0000-0000-000000000001\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"waste_id\":\"a1111111-1111-1111-1111-111111111111\",\"amount\":50000,\"payment_date\":null,\"status\":\"pending\",\"proof_file_url\":null,\"created_at\":\"2026-10-08T11:00:00Z\",\"updated_at\":\"2026-10-08T11:00:00Z\"}}"
            }
          ]
        },
        {
          "name": "GET List payments",
          "request": { "method": "GET", "url": "{{base_url}}/api/payments?status=pending&household_id={{household_id}}&start_date=2026-08-01&end_date=2026-10-08", "description": "Daftar payment, dapat difilter status, household_id, dan rentang tanggal (start_date, end_date format 2006-01-02, contoh sudah terisi, hapus bila tidak perlu). 200 + meta pagination." },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "header": [], "url": "{{base_url}}/api/payments?status=pending&household_id={{household_id}}&start_date=2026-08-01&end_date=2026-10-08" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":[{\"id\":\"b0000000-0000-0000-0000-000000000001\",\"household_id\":\"11111111-1111-1111-1111-111111111111\",\"waste_id\":\"a1111111-1111-1111-1111-111111111111\",\"amount\":50000,\"payment_date\":null,\"status\":\"pending\",\"proof_file_url\":null,\"created_at\":\"2026-10-08T11:00:00Z\",\"updated_at\":\"2026-10-08T11:00:00Z\"}],\"meta\":{\"total\":1,\"page\":1,\"limit\":10,\"total_pages\":1}}"
            }
          ]
        },
        {
          "name": "PUT Confirm payment",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/payments/{{payment_id}}/confirm",
            "body": { "mode": "formdata", "formdata": [{ "key": "proof", "type": "file", "src": "bukti.jpg" }] },
            "description": "Konfirmasi payment dengan upload file bukti bayar (jpg/jpeg/png/webp, max ikut MAX_UPLOAD_MB default 5MB). Pilih file lokal pada field proof sebelum Send, contoh pakai salah satu file di uploads/seed_bukti_*.jpg. File tersimpan di folder uploads dan URL-nya tersimpan pada record payment, status menjadi paid."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "PUT", "header": [], "url": "{{base_url}}/api/payments/{{payment_id}}/confirm" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
