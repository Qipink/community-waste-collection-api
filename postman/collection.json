_at\":\"2026-08-19T10:00:00Z\"},{\"id\":\"10000000-0000-0000-0000-000000000010\",\"owner_name\":\"Dedi Kurniawan\",\"address\":\"Jl. Raya Madyopuro No. 44, Kedungkandang, Malang\",\"created_at\":\"2026-08-21T10:00:00Z\",\"updated_at\":\"2026-08-21T10:00:00Z\"}],\"meta\":{\"total\":32,\"page\":1,\"limit\":10,\"total_pages\":4}}"
            }
          ]
        },
        {
