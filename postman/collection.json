          "request": { "method": "DELETE", "url": "{{base_url}}/api/households/{{household_id}}", "description": "Hapus household (soft delete). 200, 404 jika tidak ada. Catatan: menghapus household_id variable, jalankan request ini terakhir untuk folder ini atau buat ulang via request pertama." },
          "response": [
            {
              "name": "200 OK",
