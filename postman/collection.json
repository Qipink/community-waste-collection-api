{
  "info": {
    "name": "Community Waste Collection API",
    "_postman_id": "geu-waste-api-001",
    "description": "Collection 14 endpoint sesuai requirement Tes Backend Go PT Green Energi Utama. Cara pakai: 1) set base_url (default http://localhost:8080), 2) jalankan berurutan dari atas ke bawah, id household/pickup/payment otomatis tersimpan ke variable, 3) untuk confirm payment, pilih file lokal pada field form-data proof. Seed bawaan tersedia agar bisa langsung dicoba dengan ID contoh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "household_id", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "pickup_id", "value": "a1111111-1111-1111-1111-111111111111" },
    { "key": "payment_id", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Household API",
      "item": [
        {
          "name": "POST Create household",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/households",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"owner_name\": \"Budi Santoso\", \"address\": \"Jl. Merdeka No. 10, Malang\"}", "options": { "raw": { "language": "json" } } },
            "description": "Buat household baru. 201 + id tersimpan otomatis ke variable household_id."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 201', function () { pm.response.to.have.status(201); });", "try { var j = pm.response.json(); if (j.data && j.data.id) { pm.collectionVariables.set('household_id', j.data.id); } } catch (e) {}"] } }],
          "response": [
            {
              "name": "201 Created",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/households" },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"status\":\"success\",\"data\":{\"id\":\"11111111-1111-1111-1111-111111111111\",\"owner_name\":\"Budi Santoso\",\"address\":\"Jl. Merdeka No. 10, Malang\",\"created_at\":\"2026-10-08T10:00:00Z\",\"updated_at\":\"2026-10-08T10:00:00Z\"}}"
            }
          ]
        },
        {
